{
  "name": "roleplai",
  "version": "0.1.0",
  "description": "A single-player role-playing game run by AI, with a real game engine underneath.",
  "type": "module",
  "private": true,
  "bin": { "roleplai": "src/cli.ts" },
  "scripts": {
    "play": "bun src/cli.ts play",
    "new": "bun src/cli.ts new",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "eval": "bun src/cli.ts eval",
    "models:check": "bun src/cli.ts models"
  },
  "dependencies": {
    "sqlite-vec": "0.1.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
